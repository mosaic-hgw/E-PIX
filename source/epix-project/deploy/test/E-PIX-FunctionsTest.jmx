                  </elementProp>
                </HTTPSamplerProxy>
                <hashTree>
                  <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="test StatusCode (ignore)" enabled="true">
                    <collectionProp name="Asserion.test_strings">
                      <stringProp name="-2066996711">${__groovy(vars.get(&apos;TEST_STATUS_CODE&apos;))}</stringProp>
                    </collectionProp>
