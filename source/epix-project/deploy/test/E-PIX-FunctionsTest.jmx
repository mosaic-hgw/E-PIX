            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test version 2024.1.0" enabled="true">
              <stringProp name="TestPlan.comments">v1.0</stringProp>
              <stringProp name="BeanShellAssertion.query">import java.util.ArrayList;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.apache.commons.lang3.ArrayUtils;
import org.w3c.dom.Document;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

ArrayList elem = new ArrayList();

//---change-only-this---------------------------------------
version = &quot;2024.1.0&quot;;
elem.add(&quot;addDomain&quot;);
elem.add(&quot;addIdentifierDomain&quot;);
elem.add(&quot;addSource&quot;);
elem.add(&quot;countIdentityHistoriesForDomain&quot;);
elem.add(&quot;countPossibleMatchHistoriesForDomain&quot;);
elem.add(&quot;deleteDomain&quot;);
elem.add(&quot;deleteIdentifierDomain&quot;);
elem.add(&quot;deleteSource&quot;);
elem.add(&quot;encodeMatchingConfiguration&quot;);
elem.add(&quot;getConfigurationForDomain&quot;);
elem.add(&quot;getDeacticatedIdentitiesForDomain&quot;);
elem.add(&quot;getDeactivatedPersonsForDomain&quot;);
elem.add(&quot;getDefinedDeduplicationReasons&quot;);
elem.add(&quot;getDomain&quot;);
elem.add(&quot;getDomains&quot;);
elem.add(&quot;getHistoryForContact&quot;);
elem.add(&quot;getHistoryForIdentifier&quot;);
elem.add(&quot;getHistoryForIdentity&quot;);
elem.add(&quot;getHistoryForPerson&quot;);
elem.add(&quot;getIdentifierDomain&quot;);
elem.add(&quot;getIdentifierDomains&quot;);
elem.add(&quot;getIdentityById&quot;);
elem.add(&quot;getIdentityHistoriesForDomain&quot;);
elem.add(&quot;getIdentityHistoriesForDomainFiltered&quot;);
elem.add(&quot;getIdentityHistoriesForDomainPaginated&quot;);
elem.add(&quot;getIdentityHistoryByPersonId&quot;);
elem.add(&quot;getPersonById&quot;);
elem.add(&quot;getPossibleMatchHistoryByIdentity&quot;);
elem.add(&quot;getPossibleMatchHistoryForPerson&quot;);
elem.add(&quot;getPossibleMatchHistoryForUpdatedIdentity&quot;);
elem.add(&quot;getSource&quot;);
elem.add(&quot;getSources&quot;);
elem.add(&quot;parseMatchingConfiguration&quot;);
elem.add(&quot;updateDomain&quot;);
elem.add(&quot;updateDomainInUse&quot;);
elem.add(&quot;updateIdentifierDomain&quot;);
elem.add(&quot;updateSource&quot;);
//----------------------------------------------------------


// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.getMessage();
}

if (Failure != true) try {
	NodeList nodes = (NodeList) XPathFactory.newInstance().newXPath().compile(&quot;/definitions/types/schema/element&quot;).evaluate(doc, XPathConstants.NODESET);
	ArrayList names = new ArrayList();
	ArrayList notFound = new ArrayList();
	// ignore Exceptions and Response
	for (i = 0; i &lt; nodes.getLength(); i++) {
		//log.info(&quot;&quot; + nodeList.item(i).getAttribute(&quot;name&quot;));
		if (
			!nodes.item(i).getAttribute(&quot;name&quot;).endsWith(&quot;Exception&quot;) &amp;&amp; !nodes.item(i).getAttribute(&quot;name&quot;).endsWith(&quot;Response&quot;) &amp;&amp;
			!nodes.item(i).getAttribute(&quot;name&quot;).endsWith(&quot;DTO&quot;) &amp;&amp; !nodes.item(i).getAttribute(&quot;name&quot;).equals(&quot;psndto&quot;)
		) names.add(nodes.item(i).getAttribute(&quot;name&quot;));
	}
	ArrayList newList = names.clone();
	log.info(&quot;names = &quot; + names.size());
	log.info(&quot;elem = &quot; + elem.size());
	for (i = 0; i &lt; names.size(); i++) {
		if (elem.contains(names.get(i))) {
			elem.remove(names.get(i));
			log.info(&quot;found:&quot; + names.get(i) + &quot; count:&quot; + elem.size());
		} else {
			notFound.add(names.get(i));
			log.info(&quot;not found:&quot; + names.get(i) + &quot; count:&quot; + notFound.size());	
		}
	}
	if (notFound.size() &gt; 0 || elem.size() &gt; 0) {
		Failure = true ;
		FailureMessage = &quot;divergent elements found!&quot;;
		if (notFound.size() &gt; 0) {
			FailureMessage += &quot;\n\nnew elements:\n - &quot; + String.join(&quot;\n - &quot;, notFound);
		}
		if (elem.size() &gt; 0) {
			FailureMessage += &quot;\n\nremoved elements:\n - &quot; + String.join(&quot;\n - &quot;, elem);
		}
		if (notFound.size() &gt; 0 || elem.size() &gt; 0) {
			FailureMessage += &quot;\n\nnew list:\nelem.add(\&quot;&quot; + String.join(&quot;\&quot;);\nelem.add(\&quot;&quot;, newList) + &quot;\&quot;);&quot;;
		}
	}
} catch (Exception e) {
	Failure = true ;
	FailureMessage = &quot;Cannot read result because: &quot; + e.getMessage();
}

// version-check
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
ArrayList checkedVersions = isSet(&quot;GICS_CHECKED_VERSION&quot;) ? new ArrayList(Arrays.asList(vars.get(&quot;GICS_CHECKED_VERSION&quot;).split(&quot;,&quot;))) : new ArrayList();
ArrayList equalsVersions = isSet(&quot;GICS_EQUALS_TO_VERSION&quot;) ? new ArrayList(Arrays.asList(vars.get(&quot;GICS_EQUALS_TO_VERSION&quot;).split(&quot;,&quot;))) : new ArrayList();
if (Failure) {
	if (checkedVersions.contains(version)) equalsVersions.remove(version);
	else checkedVersions.add(version);
} else if (!checkedVersions.contains(version)) {
	checkedVersions.add(version);
	equalsVersions.add(version);
}
vars.put(&quot;GICS_VERSION_CHECKED&quot;, String.join(&quot;,&quot;, checkedVersions));
vars.put(&quot;GICS_VERSION_EQUALS_TO&quot;, String.join(&quot;,&quot;, equalsVersions));
</stringProp>
