          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="set EPIX_GETPERSONSFORDOMAIN_TIME">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">import java.math.BigInteger;

// Sicherstellen, dass die Platzhalter korrekt aufgelöst werden
String timeStartStr = vars.get(&quot;EPIX_GETPERSONSFORDOMAIN_TS&quot;)
String timeEndStr = &quot;${__time()}&quot;

// Überprüfen, ob die Variablen null sind
if (timeStartStr == null || timeEndStr == null) {
    log.error(&quot;EPIX_GETPERSONSFORDOMAIN_TS or __time() is null&quot;)
    return
}

try {
    BigInteger timeStart = new BigInteger(timeStartStr)
    BigInteger timeEnd = new BigInteger(timeEndStr)

    // Berechnung der Zeitdifferenz in Sekunden
    Float getTime = (timeEnd.subtract(timeStart).floatValue() / 1000)
    vars.put(&quot;EPIX_GETPERSONSFORDOMAIN_TIME&quot;, getTime.toString())

    // Aktualisieren der Ergebnisanzahl
    String resultCountStr = props.get(&quot;RESULT_COUNT&quot;)
    String currentResultCountStr = vars.get(&quot;CURRENT_RESULT_COUNT&quot;)

    if (resultCountStr == null || currentResultCountStr == null) {
        log.error(&quot;RESULT_COUNT or CURRENT_RESULT_COUNT is null&quot;)
        return
    }

    Integer resultCount = Integer.parseInt(resultCountStr)
    Integer currentResultCount = Integer.parseInt(currentResultCountStr)
    props.put(&quot;RESULT_COUNT&quot;, (resultCount + currentResultCount).toString())

    // Ausgabe der Informationen
    String out = &quot;### GET PERSONS FOR DOMAIN (at loop:${LOOP_COUNT}, in time:&quot; + getTime + &quot;s, results:&quot; + currentResultCount + &quot;)&quot;
    log.info(out)
} catch (Exception e) {
    log.error(&quot;Error in processing script: &quot;, e)
}
</stringProp>
          </JSR223Sampler>
