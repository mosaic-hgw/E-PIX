    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="set individual variables"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="set individual variables" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">// CONNECTION /////////////////////////////////////////////////////////////////////////////////////////
//vars.put(&quot;EPIX_SOAP_PROTOCOL&quot;,              &quot;http&quot;);
vars.put(&quot;EPIX_SOAP_HOST&quot;,                  &quot;192.168.56.101&quot;);
//vars.put(&quot;EPIX_SOAP_PORT&quot;,                  &quot;20412&quot;);
//vars.put(&quot;EPIX_SOAP_CONTEXT&quot;,               &quot;&quot;);
//vars.put(&quot;EPIX_SOAP_MANAGEMENT&quot;,            &quot;${EPIX_SOAP_SERVICE}&quot;);
//vars.put(&quot;EPIX_SOAP_SERVICE&quot;,               &quot;&quot;);
//vars.put(&quot;EPIX_FHIR_SERVICE&quot;,               &quot;&quot;);

// DOMAIN-CONFIGURATION ///////////////////////////////////////////////////////////////////////////////
vars.put(&quot;DOMAIN&quot;,                          &quot;${__UUID()}&quot;);
vars.put(&quot;EPIX_DOMAIN_CONFIG_FILE&quot;,         &quot;loadtest-domain-config.xml&quot;);
//vars.put(&quot;EPIX_IMPORT_FILE&quot;,                &quot;2023-09-02_0-4mio.csv&quot;);

// TEST-CONFIGURATION /////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;THREADS&quot;,                         &quot;1&quot;);
vars.put(&quot;RAMP_UP&quot;,                         &quot;0&quot;);
vars.put(&quot;LOOPS&quot;,                           &quot;5&quot;);
//vars.put(&quot;NEXT_REQUEST_TIME&quot;,               &quot;0&quot;);
vars.put(&quot;PACKAGE_SIZE&quot;,                    &quot;5&quot;);
vars.put(&quot;ABORT_ON_RESPONSE_ERROR&quot;,         &quot;true&quot;);

// RESTART-CONFIGURATION //////////////////////////////////////////////////////////////////////////////
vars.put(&quot;RESTART_WILDFLY_EVERY_X_LOOPS&quot;,   &quot;0&quot;);
vars.put(&quot;RESTART_WILDFLY_MIN_COUNT&quot;,       &quot;0&quot;);
vars.put(&quot;RESTART_WILDFLY_ADMIN_USER&quot;,      &quot;admin&quot;);
vars.put(&quot;RESTART_WILDFLY_ADMIN_PASSWORD&quot;,  &quot;wildfly_password&quot;);

// GET-PSNs-TEST //////////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;GET_IDATS_EVERY_X_LOOPS&quot;,         &quot;0&quot;);
vars.put(&quot;GET_IDATS_HOW_MANY&quot;,              &quot;500&quot;);

// DB-STATS-LOGGING ///////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;DB_STATS_LOGGING_EVERY_X_LOOPS&quot;,  &quot;0&quot;);
vars.put(&quot;DB_STATS_DB_HOST&quot;,                &quot;192.168.56.101&quot;);
vars.put(&quot;DB_STATS_DB_PORT&quot;,                &quot;3306&quot;);
vars.put(&quot;DB_STATS_DB_NAME&quot;,                &quot;epix&quot;);
vars.put(&quot;DB_STATS_DB_USER&quot;,                &quot;root&quot;);
vars.put(&quot;DB_STATS_DB_PASSWORD&quot;,            &quot;root&quot;);
</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="log configuration before start">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">String out = 	&quot;#\n&quot; +
	&quot;# CONFIGURATION\n&quot; +
	&quot;# =============\n&quot; + 
	&quot;# EPIX_SOAP_PROTOCOL              = ${EPIX_SOAP_PROTOCOL}\n&quot; + 
	&quot;# EPIX_SOAP_HOST                  = ${EPIX_SOAP_HOST}\n&quot; + 
	&quot;# EPIX_SOAP_PORT                  = ${EPIX_SOAP_PORT}\n&quot; + 
	&quot;# EPIX_SOAP_CONTEXT               = ${EPIX_SOAP_CONTEXT}\n&quot; +
	&quot;# EPIX_SOAP_MANAGEMENT            = ${EPIX_SOAP_MANAGEMENT}\n&quot; +
	&quot;# EPIX_SOAP_SERVICE               = ${EPIX_SOAP_SERVICE}\n&quot; +
	&quot;# EPIX_FHIR_SERVICE               = ${EPIX_FHIR_SERVICE}\n&quot; +
	&quot;#\n&quot; +
	&quot;# EPIX_DOMAIN_CONFIG_FILE         = ${EPIX_DOMAIN_CONFIG_FILE}\n&quot; +
	&quot;# EPIX_IMPORT_FILE                = ${EPIX_IMPORT_FILE}\n&quot; +
	&quot;#\n&quot; +
	&quot;# THREADS                         = ${THREADS}\n&quot; +
	&quot;# RAMP_UP                         = ${RAMP_UP}\n&quot; +
	&quot;# LOOPS                           = ${LOOPS}\n&quot; +
	&quot;# PACKAGE_SIZE                    = ${PACKAGE_SIZE}\n&quot; +
	&quot;# NEXT_REQUEST_TIME               = ${NEXT_REQUEST_TIME}\n&quot; +
	&quot;# ABORT_ON_RESPONSE_ERROR         = ${ABORT_ON_RESPONSE_ERROR}\n&quot; +
	&quot;#\n&quot; +
	&quot;# RESTART_WILDFLY_EVERY_X_LOOPS   = ${RESTART_WILDFLY_EVERY_X_LOOPS} (enabled if grater than 0)\n&quot; +
	&quot;# RESTART_WILDFLY_MIN_COUNT       = ${RESTART_WILDFLY_MIN_COUNT}\n&quot; +
	&quot;# RESTART_WILDFLY_ADMIN_USER      = ${RESTART_WILDFLY_ADMIN_USER}\n&quot; +
	&quot;# RESTART_WILDFLY_ADMIN_PASSWORD  = ${RESTART_WILDFLY_ADMIN_PASSWORD}\n&quot; +
	&quot;#\n&quot; +
	&quot;# GET_IDATS_EVERY_X_LOOPS         = ${GET_IDATS_EVERY_X_LOOPS} (enabled if grater than 0)\n&quot; +
	&quot;# GET_IDATS_HOW_MANY              = ${GET_IDATS_HOW_MANY}\n&quot; +
	&quot;#\n&quot; +
	&quot;# DB_STATS_LOGGING_EVERY_X_LOOPS  = ${DB_STATS_LOGGING_EVERY_X_LOOPS} (enabled if grater than 0)\n&quot; +
	&quot;# DB_STATS_DB_HOST                = ${DB_STATS_DB_HOST}\n&quot; +
	&quot;# DB_STATS_DB_PORT                = ${DB_STATS_DB_PORT}\n&quot; +
	&quot;# DB_STATS_DB_NAME                = ${DB_STATS_DB_NAME}\n&quot; +
	&quot;# DB_STATS_DB_USER                = ${DB_STATS_DB_USER}\n&quot; +
	&quot;# DB_STATS_DB_PASSWORD            = ${DB_STATS_DB_PASSWORD}\n&quot; +
	&quot;#&quot;;
System.out.println(out);
log.info(&quot;\n&quot;+out);</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="set variables and properties">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">import java.util.regex.Pattern;
import java.util.regex.Matcher;

Pattern pattern = Pattern.compile(&quot;(1|yes|on|true)&quot;);
Matcher matcher = pattern.matcher(&quot;${ABORT_ON_RESPONSE_ERROR}&quot;.toLowerCase());
props.put(&quot;ABORT_ON_RESPONSE_ERROR&quot;, matcher.find().toString());
props.put(&quot;EPIX_IMPORT_FILE&quot;, &quot;${EPIX_IMPORT_FILE}&quot;);
props.put(&quot;DOMAIN&quot;, &quot;${DOMAIN}&quot;);

props.put(&quot;IDENTITY_COUNT&quot;,     &quot;0&quot;);
props.put(&quot;RESULT_COUNT&quot;,       &quot;0&quot;);
props.put(&quot;TEST_TIME&quot;,          ${__time(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)});
props.put(&quot;WILDFLY_RESTARTING&quot;, &quot;false&quot;);
props.put(&quot;THREADS&quot;,            &quot;${THREADS}&quot;);
props.put(&quot;RAMP_UP&quot;,            &quot;${RAMP_UP}&quot;);
props.put(&quot;LOOPS&quot;,              &quot;${LOOPS}&quot;);
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="create domain from xml"/>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="add idat-domain">
            <stringProp name="HTTPSampler.domain">${EPIX_SOAP_HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${EPIX_SOAP_PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">${EPIX_SOAP_PROTOCOL}</stringProp>
            <stringProp name="HTTPSampler.path">${EPIX_SOAP_CONTEXT}/${EPIX_SOAP_MANAGEMENT}</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
