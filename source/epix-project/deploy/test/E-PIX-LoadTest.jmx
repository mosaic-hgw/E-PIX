        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="set variables">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">
// check optional loops ////////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;LOOP_COUNT&quot;, &quot;&quot; + vars.getIteration());


vars.put(&quot;LOOP_FOR_RESTART_WF&quot;, &quot;&quot; + (${__threadNum}==1 &amp;&amp; ${RESTART_WILDFLY_EVERY_X_LOOPS}&gt;0 &amp;&amp; Integer.parseInt(props.get(&quot;IDENTITY_COUNT&quot;))&gt;=${RESTART_WILDFLY_MIN_COUNT} &amp;&amp; vars.getIteration() % ${RESTART_WILDFLY_EVERY_X_LOOPS}==0));
vars.put(&quot;LOOP_FOR_STATISTICS&quot;, &quot;&quot; + (${__threadNum}==1 &amp;&amp; ${DB_STATS_LOGGING_EVERY_X_LOOPS}&gt;0 &amp;&amp; vars.getIteration() % ${DB_STATS_LOGGING_EVERY_X_LOOPS}==0));
vars.put(&quot;LOOP_FOR_GETPERSONS&quot;, &quot;&quot; + (${__threadNum}==1 &amp;&amp; ${GET_IDATS_EVERY_X_LOOPS}&gt;0 &amp;&amp; vars.getIteration() % ${GET_IDATS_EVERY_X_LOOPS}==0));

vars.remove(&quot;WILDFLY_RESTART_TIME&quot;);
vars.remove(&quot;EPIX_GETPERSONSFORDOMAIN_TIME&quot;);

//String out = &quot;### THREAD:&quot;+${__threadNum}+&quot;, LOOP:&quot;+vars.getIteration()+&quot;, DOMAIN:&quot;+vars.get(&quot;CURRENT_DOMAIN&quot;)+&quot;, COUNT:&quot;+${__P(IDENTITY_COUNT)};
//log.info(out);
//System.out.println(out);
</stringProp>
