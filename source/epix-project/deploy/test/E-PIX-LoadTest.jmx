            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="build identity">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.w3c.dom.Document;
import org.w3c.dom.Element;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.apache.xerces.dom.DocumentImpl;

boolean isSet(String value) {
    def variable = vars.get(value)
    return variable != null &amp;&amp; variable.length() &gt; 0 &amp;&amp; !variable.startsWith(&apos;${&apos;)
}

Document doc = new DocumentImpl();
Element root = doc.createElement(&quot;root&quot;);
doc.appendChild(root);

//-------------------------------------------
// identifier sap-patid
if (isSet(&quot;IDENTIFIER_1&quot;)) {
	String[] ids = vars.get(&quot;IDENTIFIER_1&quot;).split(&quot;,&quot;);
	for (int i=0; i&lt;ids.length; i++) {
		root.appendChild(identifier = doc.createElement(&quot;identifier&quot;));
		identifier.appendChild(identifierDomain = doc.createElement(&quot;identifierDomain&quot;));
		identifierDomain.appendChild(name = doc.createElement(&quot;name&quot;));
		name.appendChild(doc.createTextNode(&quot;kv-nr&quot;));
		identifier.appendChild(value = doc.createElement(&quot;value&quot;));
		value.appendChild(doc.createTextNode(ids[i]));
	}
}

// identifier sap-caseid
if (isSet(&quot;IDENTIFIER_2&quot;)) {
	String[] ids = vars.get(&quot;IDENTIFIER_2&quot;).split(&quot;,&quot;);
	for (int i=0; i&lt;ids.length; i++) {
		root.appendChild(identifier = doc.createElement(&quot;identifier&quot;));
		identifier.appendChild(identifierDomain = doc.createElement(&quot;identifierDomain&quot;));
		identifierDomain.appendChild(name = doc.createElement(&quot;name&quot;));
		name.appendChild(doc.createTextNode(&quot;sap.case_id&quot;));
		identifier.appendChild(value = doc.createElement(&quot;value&quot;));
		value.appendChild(doc.createTextNode(ids[i]));
	}
}

NodeList identifiers = root.getChildNodes();
//-------------------------------------------

doc = new DocumentImpl();
Element node = null;
Element identity = doc.createElement(&quot;requestEntries&quot;);
doc.appendChild(identity);

//-------------------------------------------
if (isSet(&quot;BIRTHDATE&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;birthDate&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;BIRTHDATE&quot;).split(&quot; &quot;)[0]));
}
if (isSet(&quot;BIRTHPLACE&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;birthPlace&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;BIRTHPLACE&quot;)));
}
if (isSet(&quot;CIVILSTATUS&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;civilStatus&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;CIVILSTATUS&quot;)));
}
if (isSet(&quot;DEGREE&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;degree&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;DEGREE&quot;)));
}
if (isSet(&quot;EXTERNALDATE&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;externalDate&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;EXTERNALDATE&quot;)));
}
if (isSet(&quot;FIRSTNAME&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;firstName&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;FIRSTNAME&quot;)));
}
if (isSet(&quot;GENDER&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;gender&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;GENDER&quot;)));
}
if (isSet(&quot;LASTNAME&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;lastName&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;LASTNAME&quot;)));
}
if (isSet(&quot;MIDDLENAME&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;middleName&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;MIDDLENAME&quot;)));
}
if (isSet(&quot;MOTHERTONGUE&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;motherTongue&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;MOTHERTONGUE&quot;)));
}
if (isSet(&quot;MOTHERSMAIDENNAME&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;mothersMaidenName&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;MOTHERSMAIDENNAME&quot;)));
}
if (isSet(&quot;NATIONALITY&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;nationality&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;NATIONALITY&quot;)));
}
if (isSet(&quot;PREFIX&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;prefix&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;PREFIX&quot;)));
}
if (isSet(&quot;RACE&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;race&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;RACE&quot;)));
}
if (isSet(&quot;RELIGION&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;religion&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;RELIGION&quot;)));
}
if (isSet(&quot;SUFFIX&quot;)) {
	identity.appendChild(node = doc.createElement(&quot;suffix&quot;));
	node.appendChild(doc.createTextNode(vars.get(&quot;SUFFIX&quot;)));
}

// value1-10
for (i=1; i&lt;=10; i++) if (isSet(&quot;VALUE&quot;+i)) {
	identity.appendChild(node = doc.createElement(&quot;value&quot;+i));
	node.appendChild(doc.createTextNode(vars.get(&quot;VALUE&quot;+i)));
}

// identifiers
for (int i = 0; i &lt; identifiers.getLength(); i++) {
	Node identifier = identifiers.item(i);
	if (identifier.getNodeType() == Node.ELEMENT_NODE) {
		identity.appendChild(node = doc.importNode(identifier, true));
		doc.renameNode(node, null, &quot;identifiers&quot;);
	}
}

// contacts
if (isSet(&quot;CONTACT&quot;)) {
	String[] fields = vars.get(&quot;CONTACT&quot;).split(&quot;,&quot;);
	int i = 0;
	identity.appendChild(contacts = doc.createElement(&quot;contacts&quot;));
	contacts.appendChild(node = doc.createElement(&quot;city&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;country&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;countryCode&quot;));	node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;district&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;email&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	//contacts.appendChild(node = doc.createElement(&quot;externalDate&quot;));	node.appendChild(doc.createTextNode(fields[i++]));
	//contacts.appendChild(node = doc.createElement(&quot;municipalityKey&quot;));	node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;phone&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;state&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;street&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
	contacts.appendChild(node = doc.createElement(&quot;zipCode&quot;));		node.appendChild(doc.createTextNode(fields[i++]));
}

//-------------------------------------------

import java.io.StringWriter;
import java.nio.charset.StandardCharsets;
import javax.xml.transform.OutputKeys;
import javax.xml.transform.Transformer;
import javax.xml.transform.TransformerFactory;
import javax.xml.transform.dom.DOMSource;
import javax.xml.transform.stream.StreamResult;

// Configure transformer
Transformer transformer = TransformerFactory.newInstance().newTransformer();
transformer.setOutputProperty(OutputKeys.INDENT, &quot;yes&quot;);
transformer.setOutputProperty(&quot;{http://xml.apache.org/xslt}indent-amount&quot;, &quot;2&quot;);
transformer.setOutputProperty(OutputKeys.OMIT_XML_DECLARATION, &quot;yes&quot;);

// Transform document to string with 12 spaces prefix for each line
StringWriter stringWriter = new StringWriter();
transformer.transform(new DOMSource(doc), new StreamResult(stringWriter));

// Add 12 spaces to the beginning of each line
StringBuilder indentedStringOut = new StringBuilder();
for (String line : stringWriter.toString().split(&quot;\n&quot;)) {
    indentedStringOut.append(&quot;            &quot;).append(line).append(&quot;\n&quot;);
}

// Output the final result
vars.put(&quot;IDENTITIES&quot;, vars.get(&quot;IDENTITIES&quot;) + indentedStringOut.toString());
props.put(&quot;IDENTITY_COUNT&quot;, &quot;&quot; + (Integer.parseInt(props.get(&quot;IDENTITY_COUNT&quot;)) + 1));
</stringProp>
            </JSR223Sampler>
