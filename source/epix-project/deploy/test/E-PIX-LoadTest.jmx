            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">// CLEARING /////////////////////////////////////////////////////////////////////////////////////////
vars.remove(&quot;IDENTIFIERS_OBJ&quot;);
vars.remove(&quot;IDENTITY_OBJ&quot;);
vars.remove(&quot;IDENTITY&quot;);

// IDENTITY /////////////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;BIRTHDATE&quot;,          &quot;${__RandomDate(,1900-01-01,2000-12-31,,)}&quot;);
//vars.put(&quot;BIRTHPLACE&quot;,         &quot;&quot;);
//vars.put(&quot;CIVILSTATUS&quot;,        &quot;&quot;);
//vars.put(&quot;DEGREE&quot;,             &quot;&quot;);
vars.put(&quot;FIRSTNAME&quot;,          &quot;${__RandomString(1,BCDFGHJKLMNPRSTVWXZ)}${__RandomString(1,aeiou)}${__RandomString(1,bcdfgkjlmnprstw)}${__RandomString(1,aeiou)}${__RandomString(1,bdfgklmnprstw)}&quot;);
vars.put(&quot;GENDER&quot;,             &quot;${__RandomString(1,MFOU)}&quot;);
vars.put(&quot;LASTNAME&quot;,           &quot;${__RandomString(1,BCDFGHJKLMNPRSTVWXZ)}${__RandomString(1,aeiou)}${__RandomString(1,bcdfgkjlmnprstw)}${__RandomString(1,aeiou)}${__RandomString(1,bdfgklmnprstw)}&quot;);
//vars.put(&quot;NATIONALITY&quot;,        &quot;&quot;);
//vars.put(&quot;PREFIX&quot;,             &quot;&quot;);
//vars.put(&quot;RACE&quot;,               &quot;&quot;);
//vars.put(&quot;RELIGION&quot;,           &quot;&quot;);
//vars.put(&quot;VALUE1&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE2&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE3&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE4&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE5&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE6&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE7&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE8&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE9&quot;,             &quot;&quot;);
//vars.put(&quot;VALUE10&quot;,            &quot;&quot;);
vars.put(&quot;SOURCE_NAME&quot;,        &quot;dummy_safe_source&quot;);
//vars.put(&quot;COMMENT&quot;,            &quot;&quot;);

// IDENTIFIER ///////////////////////////////////////////////////////////////////////////////////////
//vars.put(&quot;DOMAIN_NAME&quot;,        &quot;&quot;);
//vars.put(&quot;IDENTIFIER_1&quot;,       &quot;&quot;);
//vars.put(&quot;IDENTIFIER_2&quot;,       &quot;&quot;);

// CONTACT //////////////////////////////////////////////////////////////////////////////////////////</stringProp>
