	`value` VARCHAR(2000) NOT NULL,
	PRIMARY KEY (`id`),
	INDEX `datetime` (`timestamp`),
	INDEX `starttime` (`starttime`),
	UNIQUE INDEX `timestamp_key` (`timestamp`, `key`)
)
COLLATE=&apos;utf8mb4_unicode_ci&apos;
;
