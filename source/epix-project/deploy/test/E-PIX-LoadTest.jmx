            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="abort on response error (sql)">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (&quot;${ABORT_ON_RESPONSE_ERROR}&quot;==&quot;true&quot; &amp;&amp; !&quot;200&quot;.equals(prev.getResponseCode())) {
	String out = &quot;### STOP TEST&quot;+(&quot;${THREADS}&quot;!=&quot;1&quot; ?&quot; (thread:${__threadNum})&quot; :&quot;&quot;)+&quot;: sql-error (name: &quot;+prev.getSampleLabel()+&quot;, create:&quot;+prev.getResponseCode()+&quot;)&quot;;
	out += &quot;\n--- last request: ---\n&quot; + prev.getSamplerData(); // https://stackoverflow.com/a/31139098
	out += &quot;\n--- last response: ---\n&quot; + prev.getResponseDataAsString(); // https://stackoverflow.com/a/40610509
	log.info(out);
	System.out.println(out);
	ctx.getEngine().stopTest();
}</stringProp>
