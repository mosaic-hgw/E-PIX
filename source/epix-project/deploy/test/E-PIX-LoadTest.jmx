            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="set WILDFLY_RESTARTING=false when ResponseCode=200">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// Initialisierung des Failure-Status
Failure = false

try {
    // Zugriff auf den Response Code des aktuellen Samplers
    def responseCode = prev.getResponseCode()

    // Überprüfen, ob der Response Code &quot;200&quot; ist
    if (&quot;200&quot;.equals(responseCode)) {
        props.put(&quot;WILDFLY_RESTARTING&quot;, &quot;false&quot;)

        // Sicherstellen, dass WILDFLY_RESTART_TS als Integer behandelt wird
        Integer wfRestartTs = vars.get(&quot;WILDFLY_RESTART_TS&quot;) as Integer

        // Berechnung der WILDFLY_RESTART_TIME
        Integer wfRestartTime = (System.currentTimeMillis() / 1000) as Integer - wfRestartTs
        vars.put(&quot;WILDFLY_RESTART_TIME&quot;, wfRestartTime.toString())

        String out = &quot;### WILDFLY RESTARTED (at loop: ${LOOP_COUNT}, in time: &quot; + wfRestartTime + &quot;s)&quot;
        log.info(out)
        System.out.println(out)
    }
} catch (Exception e) {
    log.error(&quot;Error in JSR223 Assertion script: &quot;, e)
    Failure = true
}
</stringProp>
              </JSR223Assertion>
