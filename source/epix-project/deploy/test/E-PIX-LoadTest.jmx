          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="get interesting variables">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def keySet = [
	&quot;LOOP_COUNT&quot;, &quot;WILDFLY_RESTART_TIME&quot;, &quot;IDENTITY_COUNT&quot;, &quot;RESULT_COUNT&quot;, &quot;EPIX_GETPERSONSFORDOMAIN_TIME&quot;
];
String out = &quot;&quot;;

// Methode zur Erstellung des Key-Value-Paares
String addKey(String key) {
    def value = vars.get(key) != null ? vars.get(key) : props.get(key)
    if (value != null) {
        return &quot;(&apos;&quot;+props.get(&quot;TEST_TIME&quot;)+&quot;&apos;,&apos;${key}&apos;,&apos;${value}&apos;)&quot;
    }
    return &quot;&quot;
}

// Erstellen der Key-Value-Paare
for (key in keySet) {
    def result = addKey(key)
    if (result) {
        out += result + &quot;,&quot;
    }
}

// Entfernen des letzten Kommas und Setzen der Variable
//if (out) {
    out = out.substring(0, out.length() - 1)
    log.info(out)
    vars.put(&quot;STAT_KEY_VALUE_PAIRS&quot;, out)
//}</stringProp>
          </JSR223Sampler>
