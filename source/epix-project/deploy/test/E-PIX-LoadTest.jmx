          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="&gt;&gt; set variables per thread">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
vars.put(&quot;TEST_TIME&quot;,               props.get(&quot;TEST_TIME&quot;));
vars.put(&quot;ABORT_ON_RESPONSE_ERROR&quot;, props.get(&quot;ABORT_ON_RESPONSE_ERROR&quot;));
vars.put(&quot;EPIX_IMPORT_FILE&quot;,        props.get(&quot;EPIX_IMPORT_FILE&quot;));
vars.put(&quot;DOMAIN&quot;,                  props.get(&quot;DOMAIN&quot;));

//log.info(&quot;\n#\n# DOMAIN: ${DOMAIN}&quot;+
//&quot;\n# DB_STATS_DB_URL: &quot;+vars.get(&quot;DB_STATS_DB_URL&quot;)+&quot;\n#&quot;);</stringProp>
