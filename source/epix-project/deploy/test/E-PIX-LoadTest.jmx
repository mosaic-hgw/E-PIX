${__groovy(vars.get(&apos;IDENTITY&apos;))}&#xd;
      &lt;/ser:requestMPI&gt;&#xd;
   &lt;/soapenv:Body&gt;&#xd;
&lt;/soapenv:Envelope&gt;</stringProp>
