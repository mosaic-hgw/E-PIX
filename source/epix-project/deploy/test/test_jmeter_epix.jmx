      <hashTree>
        <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="set variables" enabled="true">
          <collectionProp name="Arguments.arguments">
            <elementProp name="CONTEXT" elementType="Argument">
              <stringProp name="Argument.name">CONTEXT</stringProp>
              <stringProp name="Argument.value">epix</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
