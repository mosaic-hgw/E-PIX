                <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="remove persons" enabled="true">
                  <stringProp name="dataSource">${EPIX_SERVICE}</stringProp>
                  <stringProp name="query">DELETE s, p, ph, pg, pp, pgh, phi, pi, i, c, pl, plh, ch, id
 FROM       `source`                    s
  LEFT JOIN `person`                    p   ON s.id  = p.source_id
  LEFT JOIN `person_history`            ph  ON p.id  = ph.person_id
  LEFT JOIN `person_group`              pg  ON p.id  = pg.referencePerson_id
  LEFT JOIN `person_preprocessed`       pp  ON pg.id = pp.person_group_id
  LEFT JOIN `person_group_history`      pgh ON pg.id = pgh.personGroup_id
  LEFT JOIN `contact`                   c   ON p.id  = c.person_id
  LEFT JOIN `contact_history`           ch  ON ph.id = ch.person_history_id
  LEFT JOIN `person_identifier`         pi  ON p.id  = pi.persons_id
  LEFT JOIN `person_history_identifier` phi ON ph.id = phi.person_history_id
  LEFT JOIN `identifier`                i   ON (pg.firstMpi_domain_id = i.domain_id AND pg.firstMpi_local_identifier = i.local_identifier)
                                            OR (pi.localIdentifiers_domain_id = i.domain_id AND pi.localIdentifiers_local_identifier = i.local_identifier)
  LEFT JOIN `personlink`                pl  ON p.id IN (pl.destPerson_id, pl.srcPerson_id)
  LEFT JOIN `personlink_history`        plh ON p.id IN (plh.destPerson_id, plh.srcPerson_id)
  LEFT JOIN `identifier_domain`         id  ON id.id = i.domain_id AND id.id != 2
 WHERE
  s.id IN (${EPIX_SOURCE_ID_1}, ${EPIX_SOURCE_ID_2})
;

</stringProp>
                  <stringProp name="queryArguments"></stringProp>
                  <stringProp name="queryArgumentsTypes"></stringProp>
                  <stringProp name="queryTimeout"></stringProp>
                  <stringProp name="queryType">Update Statement</stringProp>
                  <stringProp name="resultSetHandler">Store as String</stringProp>
                  <stringProp name="resultVariable"></stringProp>
